exports[`email templates > accepted (production) renders the same text and HTML as approved 1`] = `
{
  "html": "<!doctype html>
<html lang="en-AU"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="color-scheme" content="light"><title>PMP-7K3QX accepted: how to pay and post your paddles</title></head>
<body style="margin:0;padding:0;background:#FBFAF6;font-family:'Work Sans',Arial,Helvetica,sans-serif">
