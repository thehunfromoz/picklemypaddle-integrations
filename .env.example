# Copy to .env for local development (.env is git-ignored). Never commit real keys.
# Staging keeps its values in /etc/picklemypaddle/integrations.env on home-server (root-only);
# production will do the same on the OVH server.

# development | staging | production
APP_ENV=development
PORT=8080
# Website origins allowed to call this service (CORS), comma-separated, no trailing slash
PUBLIC_SITE_ORIGIN=http://localhost:4321

# ── Orders (SCRUM-64 to 70) ──
# The order database. Required: the service won't start without it. On your Mac, a local Postgres:
#   docker run -d --name pmp-pg -p 5432:5432 -e POSTGRES_USER=pmp -e POSTGRES_PASSWORD=pmp -e POSTGRES_DB=pmp postgres:18-alpine
# On staging and production it lives only in the root-only secrets file (install.sh writes it).
DATABASE_URL=postgres://pmp:pmp@localhost:5432/pmp
# Where processed photos are kept (a private volume in the stacks; any folder on your Mac)
PHOTO_DIR=./.photos
# Who may set X-Forwarded-For (the gateway in the stacks). Empty = nobody.
TRUSTED_PROXIES=
# Abuse limits. Defaults: 5 orders per IP per hour, 3 per email per day, "email me my links"
# 3 per email per day and 10 per IP per hour, and a 3-second minimum fill time. Staging may raise
# the per-IP limit for its smoke traffic; production refuses to start with any limit relaxed.
#ORDER_LIMIT_PER_IP_HOUR=5
#ORDER_LIMIT_PER_EMAIL_DAY=3
#LINKS_LIMIT_PER_EMAIL_DAY=3
#LINKS_LIMIT_PER_IP_HOUR=10
#ORDER_MIN_FILL_SECONDS=3

# ── Stripe: TEST-MODE keys everywhere except production (the service refuses live keys) ──
# Dashboard → Developers → API keys (test mode). Leave empty until payments are built.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── HubSpot: the test portal everywhere except production ──
# A HubSpot service key (Settings → Integrations → Service Keys). Legacy private apps are not
# available on new accounts. Scopes: contacts, companies and deals read/write, plus their schema scopes.
# Leave empty until the CRM adapter is built.
HUBSPOT_ACCESS_TOKEN=
# Public value (also used by the site's forms)
HUBSPOT_PORTAL_ID=
