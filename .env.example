# Copy to .env for local development (.env is git-ignored). Never commit real keys.
# Staging keeps its values in /etc/picklemypaddle/integrations.env on home-server (root-only);
# production will do the same on the OVH server.

# development | staging | production
APP_ENV=development
PORT=8080
# Website origins allowed to call this service (CORS), comma-separated, no trailing slash
PUBLIC_SITE_ORIGIN=http://localhost:4321

# ── Orders (SCRUM-64 to 70) ──
# The order database. Required: the service won't start without it. On your Mac, a local Postgres:
#   docker run -d --name pmp-pg -p 5432:5432 -e POSTGRES_USER=pmp -e POSTGRES_PASSWORD=pmp -e POSTGRES_DB=pmp postgres:18-alpine
# On staging and production it lives only in the root-only secrets file (install.sh writes it).
DATABASE_URL=postgres://pmp:pmp@localhost:5432/pmp
# Where processed photos are kept (a private volume in the stacks; any folder on your Mac)
PHOTO_DIR=./.photos
# Photo engine: auto (libvips tools if installed, e.g. `brew install vips`, else sharp), vips or sharp.
# The service's image always uses vips (SCRUM-66).
IMAGE_ENGINE=auto
# Who may set X-Forwarded-For (the gateway in the stacks). Empty = nobody.
TRUSTED_PROXIES=
# Abuse limits. Defaults: 5 orders per IP per hour, 3 per email per day, "email me my links"
# 3 per email per day and 10 per IP per hour, and a 3-second minimum fill time. Staging may raise
# the per-IP limit for its smoke traffic; production refuses to start with any limit relaxed.
#ORDER_LIMIT_PER_IP_HOUR=5
#ORDER_LIMIT_PER_EMAIL_DAY=3
#LINKS_LIMIT_PER_EMAIL_DAY=3
#LINKS_LIMIT_PER_IP_HOUR=10
#ORDER_MIN_FILL_SECONDS=3

# ── Order emails (SCRUM-69) ──
# Resend API key: Resend → API Keys, "Sending access", domain picklemypaddle.com. Empty on your Mac
# = nothing is sent (the emails are marked suppressed). Required in production.
RESEND_API_KEY=
# Outside production, the ONLY addresses mail may reach (comma-separated; plus-addressing allowed).
# Required outside production. Include sales@picklemypaddle.com, where the new-order alert goes.
EMAIL_ALLOWLIST=sales@picklemypaddle.com
# Where status links in emails point. Default: the first PUBLIC_SITE_ORIGIN.
#SITE_URL=http://localhost:4321
# The tailnet admin address for the new-order alert (SCRUM-71). Until set, the alert says so.
#ADMIN_URL=

# ── Stripe: TEST-MODE keys everywhere except production (the service refuses live keys) ──
# Dashboard → Developers → API keys (test mode). Leave empty until payments are built.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── HubSpot (SCRUM-74): the test portal everywhere except production ──
# A HubSpot service key (Settings → Integrations → Service Keys), e.g. pat-ap1-…; new accounts have
# no legacy private apps. Scopes: crm.objects.contacts.read/write, crm.objects.deals.read/write,
# crm.schemas.contacts.read, crm.schemas.deals.read/write. Empty = nothing is synced.
HUBSPOT_ACCESS_TOKEN=
# The portal (account) ID the key belongs to. Public (also used by the site's forms).
HUBSPOT_PORTAL_ID=
# The test portal "PickleMyPaddle test". Outside production HUBSPOT_PORTAL_ID must equal it, so
# staging can never write to the real account; production refuses to run against it.
HUBSPOT_TEST_PORTAL_ID=
# Only if HubSpot says your data region needs a different API address.
#HUBSPOT_API_BASE=https://api.hubapi.com
